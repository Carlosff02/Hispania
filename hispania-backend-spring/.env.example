# --- Configuracion local del backend Hispania Atlas (Spring Boot) ---------------
# Copia este archivo a `.env` y exporta sus variables antes de arrancar. Este
# `.env.example` SI se versiona (el `.env` no, por eso la regla `!.env.example`
# del .gitignore de la raiz), asi que aqui va un VALOR DE EJEMPLO, nunca la
# contrasena real de tu Postgres.
#
# En PowerShell:
#   $env:DB_URL  = "jdbc:postgresql://localhost:5432/hispania_db"
#   $env:DB_USER = "postgres"
#   $env:DB_PASSWORD = "<tu contrasena>"
#   .\mvnw.cmd spring-boot:run

# JDBC de PostgreSQL. `hispania_db` es la base que ya usaba el backend de Quarkus.
DB_URL=jdbc:postgresql://localhost:5432/hispania_db

# Credenciales del usuario de PostgreSQL.
# OJO: cambia la contrasena. `application.properties` NO lleva ninguna por
# defecto a proposito, para que una clave real no acabe en el repositorio.
DB_USER=postgres
DB_PASSWORD=cambia-esta-por-la-tuya

# Puerto del servidor. El proxy de Angular espera el 8080.
PORT=8080

# Origenes permitidos por CORS, separados por coma. En produccion, si el frontend
# y el backend se sirven desde el mismo origen, se puede dejar vacio.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4200
